   "path": "https://orcid.org/0009-0001-6243-1709"
  },
  {
   "title": "T. Chithralekha",
   "role": "author",
   "organization": "Pondicherry University"
  }
 ],
 "sources": [
  {
   "title": "See sources.csv (339 public sources: PIB, NIC, MeitY, State portals, courts, news)"
  }
